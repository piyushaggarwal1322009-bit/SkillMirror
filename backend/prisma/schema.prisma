generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  INSTRUCTOR
  ADMIN
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TrainingSessionStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum AttemptStatus {
  SUBMITTED
  NEEDS_REVIEW
  NEEDS_IMPROVEMENT
  PASSED
  UNABLE_TO_VERIFY
}

enum UploadStatus {
  READY
}

enum StorageProvider {
  LOCAL
}

model User {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(254)
  passwordHash String
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projects     TrainingProject[]
  sessions     TrainingSession[]
  mediaAssets  MediaAsset[]
  authSessions AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TrainingProject {
  id           String            @id @default(cuid())
  ownerId      String
  title        String            @db.VarChar(120)
  description  String            @db.VarChar(1000)
  category     String            @db.VarChar(80)
  level        String            @db.VarChar(40)
  duration     Int
  objectives   String            @default("") @db.VarChar(500)
  materials    String[]          @default([])
  status       TrainingStatus    @default(DRAFT)
  source       String            @default("user") @db.VarChar(40)
  demonstration Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  steps        TrainingStep[]
  mediaAssets  MediaAsset[]
  sessions     TrainingSession[]

  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
}

model TrainingStep {
  id           String          @id @default(cuid())
  projectId    String
  title        String          @db.VarChar(120)
  instructions String          @db.VarChar(2000)
  position     Int
  expected     String          @default("") @db.VarChar(1000)
  verification String          @default("") @db.VarChar(1000)
  safety       String          @default("") @db.VarChar(1000)
  image        String          @default("") @db.VarChar(2048)
  feedback     String          @default("") @db.VarChar(1000)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  project      TrainingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attempts     StepAttempt[]
  mediaAssets  MediaAsset[]

  @@unique([projectId, position])
  @@index([projectId, position])
}

model MediaAsset {
  id           String          @id @default(cuid())
  ownerId      String
  projectId    String?
  sessionId    String?
  stepId       String?
  attemptId    String?
  originalName String          @db.VarChar(255)
  storageKey   String          @unique @db.VarChar(255)
  mimeType     String          @db.VarChar(120)
  sizeBytes    Int
  status       UploadStatus    @default(READY)
  provider     StorageProvider @default(LOCAL)
  createdAt    DateTime        @default(now())
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project      TrainingProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session      TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step         TrainingStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)
  attempt      StepAttempt?    @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([projectId])
  @@index([sessionId])
}

model TrainingSession {
  id               String                @id @default(cuid())
  learnerId        String
  projectId        String
  currentPosition  Int                   @default(0)
  status           TrainingSessionStatus @default(IN_PROGRESS)
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  updatedAt        DateTime              @updatedAt
  learner          User                  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  project          TrainingProject      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attempts         StepAttempt[]
  report           AssessmentReport?
  mediaAssets      MediaAsset[]

  @@index([learnerId, status, updatedAt])
  @@index([projectId, startedAt])
}

model StepAttempt {
  id                 String        @id @default(cuid())
  sessionId          String
  stepId             String
  attemptNumber      Int
  verificationStatus AttemptStatus @default(SUBMITTED)
  feedback           String        @default("") @db.VarChar(2000)
  verificationMethod String        @default("HUMAN_REVIEW") @db.VarChar(60)
  simulated          Boolean       @default(false)
  submittedAt        DateTime      @default(now())
  reviewedAt         DateTime?
  session            TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step               TrainingStep   @relation(fields: [stepId], references: [id], onDelete: Restrict)
  evidence           MediaAsset[]

  @@unique([sessionId, stepId, attemptNumber])
  @@index([sessionId, submittedAt])
  @@index([stepId, verificationStatus])
}

model AssessmentReport {
  id                       String          @id @default(cuid())
  sessionId                String          @unique
  totalSteps               Int
  attemptedSteps           Int
  passedSteps              Int
  stepsNeedingImprovement  Int
  completionPercentage     Int
  recommendations          String[]        @default([])
  assessmentMethod         String          @default("RECORDED_ATTEMPTS") @db.VarChar(80)
  simulated                Boolean         @default(false)
  createdAt                DateTime        @default(now())
  session                  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}